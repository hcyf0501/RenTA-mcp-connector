# Copy this file to config/.env and replace every placeholder.
# Do not commit config/.env.

# The public HTTPS address of the RenTA platform.
RENTA_BASE_URL=https://renta.example.com

# Your RenTA user identifier. Use a distinct test account for demos where possible.
RENTA_REQUESTER_USER_ID=replace-with-your-user-id

# Leave blank only when the target platform explicitly allows unauthenticated access.
RENTA_API_TOKEN=

# Optional overrides.
RENTA_EXECUTION_TRANSPORT=auto
RENTA_TIMEOUT_SECONDS=180
RENTA_SAVE_MAX_ATTEMPTS=2

# Keep generated platform artifacts inside a directory you control.
RENTA_OUTPUT_ROOT=.
